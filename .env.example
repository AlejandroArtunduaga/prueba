# Zona horaria de negocio. NO cambiar: es un requisito de la prueba.
TZ_NEGOCIO=America/Bogota

# Puerto del servidor
PORT=3000

# Ruta de la base SQLite (opcion por defecto, cero instalacion)
DB_PATH=./data/prueba.db

# Si prefieres SQL Server o PostgreSQL, usa docker-compose.yml
# y configura aqui tu cadena de conexion.
# DATABASE_URL=
